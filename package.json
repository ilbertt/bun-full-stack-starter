{
  "name": "bun-full-stack",
  "type": "module",
  "private": true,
  "workspaces": {
    "packages": [
      "frontend",
      "backend"
    ],
    "catalog": {
      "typescript": "^7.0.2"
    }
  },
  "scripts": {
    "backend": "bun --filter backend",
    "frontend": "bun --filter frontend",
    "frontend:dev": "bun frontend dev",
    "frontend:build": "bun frontend build",
    "check:types": "bun --filter \"*\" check:types",
    "check:codestyle": "bun run --bun biome check",
    "check:all": "bun check:types && bun check:codestyle",
    "fix:codestyle": "bun run --bun biome check --write"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.5",
    "@tanstack/router-plugin": "^1.168.23",
    "@types/bun": "^1.3.14",
    "typescript": "catalog:"
  },
  "engines": {
    "bun": "1.3.14",
    "node": "please use bun"
  },
  "packageManager": "bun@1.3.14"
}
