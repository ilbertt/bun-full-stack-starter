# Optional: falls back to https://$NIBRUN_HOSTNAME when the host injects one, else localhost:3000
BASE_URL=http://localhost:3000
DATA_FOLDER=./data
# Optional: one is generated into $DATA_FOLDER/.better-auth-secret on first start and reused from
# there afterwards. Set this to pin your own — generate with: openssl rand -base64 32
# BETTER_AUTH_SECRET="..."
